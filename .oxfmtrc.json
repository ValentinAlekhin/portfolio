{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "vueIndentScriptAndStyle": false,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".nuxt/**",
    ".output/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "public/**",
    "**/*.generated.ts"
  ]
}
