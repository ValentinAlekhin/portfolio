{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/generate-project-placeholders.mjs && nuxt build",
    "dev": "node scripts/generate-project-placeholders.mjs && nuxt dev",
    "generate": "node scripts/generate-project-placeholders.mjs && nuxt generate",
    "images:placeholders": "node scripts/generate-project-placeholders.mjs",
    "models:portrait": "node scripts/prepare-ascii-portrait.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck --checker=golar"
  },
  "dependencies": {
    "@carbon/icons-vue": "^10.140.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@nuxt/fonts": "^1.1.0",
    "@nuxt/image": "^2.2.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@takumi-rs/core": "^2.17.1",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^15.0.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "nuxt": "^4.6.2",
    "photoswipe": "^5.4.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@golar/vue": "0.1.11",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vue/test-utils": "^2.5.1",
    "golar": "0.1.11",
    "meshoptimizer": "^1.3.0",
    "nuxt-yandex-metrika": "^2.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
